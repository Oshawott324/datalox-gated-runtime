{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalox.dev/schemas/rollout-provider-set-v1.schema.json",
  "title": "Datalox task-free rollout provider set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "providers"],
  "properties": {
    "schema_version": {"const": "datalox_rollout_provider_set_v1"},
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_id", "bundle_path", "provider_runtime_sha256"],
        "properties": {
          "provider_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "bundle_path": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {"not": {"pattern": "^/"}},
              {"not": {"pattern": "^[A-Za-z]:"}},
              {"not": {"pattern": "(^|/)\\.\\.(/|$)"}},
              {"not": {"pattern": "\\\\"}}
            ]
          },
          "provider_runtime_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
