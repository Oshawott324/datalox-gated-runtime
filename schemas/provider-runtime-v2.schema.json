{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalox.dev/schemas/provider-runtime-v2.schema.json",
  "title": "Datalox task-free provider runtime bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "bundle_version",
    "authorities",
    "wire_protocol",
    "behavior",
    "source_path",
    "content_hashes"
  ],
  "properties": {
    "schema_version": {"const": "datalox_provider_runtime_v2"},
    "provider_id": {"type": "string", "minLength": 1},
    "bundle_version": {"type": "string", "minLength": 1},
    "authorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "wire_protocol": {"const": "standard_http_v1"},
    "behavior": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "implementation",
            "seed_path",
            "roles_path",
            "tools_path",
            "identity_path",
            "default_actor_role",
            "required_runtime_capabilities"
          ],
          "properties": {
            "protocol": {"const": "world_v1_adapter"},
            "implementation": {"type": "string", "minLength": 1},
            "seed_path": {"type": "string", "minLength": 1},
            "roles_path": {"type": "string", "minLength": 1},
            "tools_path": {"type": "string", "minLength": 1},
            "identity_path": {"type": "string", "minLength": 1},
            "default_actor_role": {"type": "string", "minLength": 1},
            "required_runtime_capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol", "config_path"],
          "properties": {
            "protocol": {"const": "gate_config_v1"},
            "config_path": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "source_path": {"type": "string", "minLength": 1},
    "content_hashes": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  }
}
