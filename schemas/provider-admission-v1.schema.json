{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalox.dev/schemas/provider-admission-v1.schema.json",
  "title": "Derived provider runtime admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "bundle_version",
    "provider_runtime_sha256",
    "operation_claims_sha256",
    "admitted",
    "task_free",
    "evidence_sources",
    "operations",
    "provider_invariants",
    "receipt_predicates",
    "reset_profiles",
    "behavior_probes"
  ],
  "properties": {
    "schema_version": {"const": "datalox_provider_admission_v1"},
    "provider_id": {"type": "string", "minLength": 1},
    "bundle_version": {"type": "string", "minLength": 1},
    "provider_runtime_sha256": {"$ref": "#/$defs/sha256"},
    "operation_claims_sha256": {"$ref": "#/$defs/sha256"},
    "admitted": {"const": true},
    "task_free": {"const": true},
    "evidence_sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceSource"}
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "native_surface",
          "mutability",
          "behavior_program",
          "state_effects",
          "grounding",
          "rights",
          "covered_behaviors"
        ],
        "properties": {
          "operation_id": {"type": "string", "minLength": 1},
          "native_surface": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "scheme", "authority", "method", "path_template"],
            "properties": {
              "type": {"const": "http"},
              "scheme": {"const": "https"},
              "authority": {"type": "string", "minLength": 1},
              "method": {"type": "string", "pattern": "^[A-Z]+$"},
              "path_template": {
                "type": "string",
                "pattern": "^/(?:$|(?:\\{[A-Za-z_][A-Za-z0-9_]*\\}|[^/{}]+)(?:/(?:\\{[A-Za-z_][A-Za-z0-9_]*\\}|[^/{}]+))*)$"
              }
            }
          },
          "mutability": {"enum": ["read", "write"]},
          "behavior_program": {"type": "string", "minLength": 1},
          "state_effects": {"type": "array", "items": {"type": "string"}},
          "grounding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "evidence_refs", "grounded"],
            "properties": {
              "level": {"type": "string", "pattern": "^G[0-4](?:_[A-Z0-9]+)*$"},
              "evidence_refs": {"type": "array", "items": {"type": "string"}},
              "grounded": {"type": "boolean"}
            }
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": ["distribution_label", "behavior_distribution_basis"],
            "properties": {
              "distribution_label": {"enum": ["public", "restricted", "private"]},
              "behavior_distribution_basis": {"type": "string", "minLength": 1}
            }
          },
          "covered_behaviors": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "success": {"const": true},
              "failure": {"const": true},
              "duplicate": {"const": true},
              "readback": {"const": true},
              "async": {"const": true},
              "pagination": {"const": true}
            },
            "minProperties": 1
          }
        }
      }
    },
    "provider_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/admittedInvariant"}
    },
    "receipt_predicates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/admittedPredicate"}
    },
    "reset_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "kind", "functional_equivalence_passed"],
        "properties": {
          "profile_id": {"type": "string"},
          "kind": {"type": "string"},
          "functional_equivalence_passed": {"const": true}
        }
      }
    },
    "behavior_probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["probe_id", "step_count", "first_run_sha256", "second_run_sha256"],
        "properties": {
          "probe_id": {"type": "string"},
          "step_count": {"type": "integer", "minimum": 1},
          "first_run_sha256": {"$ref": "#/$defs/sha256"},
          "second_run_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "artifact_ref",
        "artifact_sha256",
        "grounding_level",
        "observed_at",
        "valid_through",
        "distribution_label",
        "rights_basis"
      ],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "artifact_ref": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "grounding_level": {
          "type": "string",
          "pattern": "^G[0-4](?:_[A-Z0-9]+)*$"
        },
        "observed_at": {"type": "string", "format": "date-time"},
        "valid_through": {"type": "string", "format": "date-time"},
        "distribution_label": {"enum": ["public", "restricted", "private"]},
        "rights_basis": {"type": "string", "minLength": 1}
      }
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
    },
    "admittedInvariant": {
      "allOf": [
        {"$ref": "#/$defs/admittedPredicate"},
        {
          "type": "object",
          "properties": {
            "source": {"enum": ["provider_state", "call_evidence"]}
          }
        }
      ]
    },
    "admittedPredicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["predicate_id", "source", "operator", "pointer", "passed"],
          "properties": {
            "predicate_id": {"type": "string", "minLength": 1},
            "source": {"enum": ["response_body", "provider_state", "call_evidence"]},
            "operator": {"const": "exists"},
            "pointer": {"$ref": "#/$defs/jsonPointer"},
            "passed": {"const": true}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "predicate_id",
            "source",
            "operator",
            "pointer",
            "expected",
            "passed"
          ],
          "properties": {
            "predicate_id": {"type": "string", "minLength": 1},
            "source": {"enum": ["response_body", "provider_state", "call_evidence"]},
            "operator": {"const": "equals"},
            "pointer": {"$ref": "#/$defs/jsonPointer"},
            "expected": {},
            "passed": {"const": true}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "predicate_id",
            "source",
            "operator",
            "pointer",
            "expected_type",
            "passed"
          ],
          "properties": {
            "predicate_id": {"type": "string", "minLength": 1},
            "source": {"enum": ["response_body", "provider_state", "call_evidence"]},
            "operator": {"const": "type"},
            "pointer": {"$ref": "#/$defs/jsonPointer"},
            "expected_type": {
              "enum": ["object", "array", "string", "number", "integer", "boolean", "null"]
            },
            "passed": {"const": true}
          }
        }
      ]
    }
  }
}
