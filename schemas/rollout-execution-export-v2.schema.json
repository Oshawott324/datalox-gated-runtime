{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalox.dev/schemas/rollout-execution-export-v2.schema.json",
  "title": "Datalox admitted registry-backed rollout execution export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "uid",
    "session_id",
    "environment_seed",
    "provider_set_sha256",
    "provider_set_schema_version",
    "providers",
    "initial_provider_fingerprint",
    "final_provider_exports",
    "consumer_exit_codes",
    "consumer_exit_code"
  ],
  "properties": {
    "schema_version": {"const": "datalox_rollout_execution_export_v2"},
    "uid": {"type": "string", "minLength": 1, "maxLength": 256},
    "session_id": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "string", "minLength": 1, "maxLength": 256}
      ]
    },
    "environment_seed": {"type": "integer", "minimum": 0},
    "provider_set_sha256": {"$ref": "#/$defs/sha256"},
    "provider_set_schema_version": {"const": "datalox_rollout_provider_set_v2"},
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_id",
          "release_reference",
          "release_manifest_sha256",
          "release_config_sha256",
          "profile_id",
          "profile_layer_sha256",
          "provider_runtime_sha256",
          "provider_admission_sha256",
          "operation_contract_sha256",
          "authorities"
        ],
        "properties": {
          "provider_id": {"$ref": "#/$defs/identifier"},
          "release_reference": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*@[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "release_manifest_sha256": {"$ref": "#/$defs/sha256"},
          "release_config_sha256": {"$ref": "#/$defs/sha256"},
          "profile_id": {"$ref": "#/$defs/identifier"},
          "profile_layer_sha256": {"$ref": "#/$defs/sha256"},
          "provider_runtime_sha256": {"$ref": "#/$defs/sha256"},
          "provider_admission_sha256": {"$ref": "#/$defs/sha256"},
          "operation_contract_sha256": {"$ref": "#/$defs/sha256"},
          "authorities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "initial_provider_fingerprint": {"$ref": "#/$defs/sha256"},
    "final_provider_exports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema_version", "provider_id"],
        "properties": {
          "schema_version": {"const": "datalox_provider_run_v1"},
          "provider_id": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "consumer_exit_codes": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0, "maximum": 255}
    },
    "consumer_exit_code": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 255
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
