{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalox.dev/schemas/provider-grounding-measurement-v1.schema.json",
  "title": "Provider grounding measurement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "measurement_id",
    "provider_id",
    "provider_version",
    "program_id",
    "observed_at",
    "capture_sha256",
    "connector_sha256",
    "recipe_sha256",
    "harvest_engine_sha256",
    "compiled_program_sha256",
    "completion",
    "rights_ref",
    "distribution"
  ],
  "properties": {
    "schema_version": {"const": "datalox_provider_grounding_measurement_v1"},
    "measurement_id": {"$ref": "#/$defs/identifier"},
    "provider_id": {"$ref": "#/$defs/identifier"},
    "provider_version": {"type": "string", "minLength": 1},
    "program_id": {"$ref": "#/$defs/identifier"},
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "format": "date-time"
    },
    "capture_sha256": {"$ref": "#/$defs/sha256"},
    "connector_sha256": {"$ref": "#/$defs/sha256"},
    "recipe_sha256": {"$ref": "#/$defs/sha256"},
    "harvest_engine_sha256": {"$ref": "#/$defs/sha256"},
    "compiled_program_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "source_reset_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "completion": {"enum": ["complete", "incomplete"]},
    "rights_ref": {"$ref": "#/$defs/identifier"},
    "distribution": {"enum": ["public", "restricted", "private"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {"completion": {"const": "complete"}},
        "required": ["completion"]
      },
      "then": {
        "properties": {
          "compiled_program_sha256": {"$ref": "#/$defs/sha256"}
        }
      },
      "else": {
        "properties": {"compiled_program_sha256": {"type": "null"}}
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
