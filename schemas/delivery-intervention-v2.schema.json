{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalox.dev/schemas/delivery-intervention-v2.schema.json",
  "title": "Durable transport delivery intervention configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "mode", "seed", "policy", "policy_sha256"],
  "properties": {
    "schema_version": {"const": "datalox_delivery_intervention_v2"},
    "provider_id": {"$ref": "#/$defs/identifier"},
    "mode": {"enum": ["off", "on"]},
    "seed": {"type": "string", "minLength": 1, "maxLength": 256},
    "policy": {"$ref": "#/$defs/policy"},
    "policy_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "phase"],
      "properties": {
        "kind": {"const": "no_response"},
        "phase": {"enum": ["pre_dispatch", "post_dispatch"]}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "request_index", "operation_id", "action"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/identifier"},
        "request_index": {"type": "integer", "minimum": 1},
        "operation_id": {"$ref": "#/$defs/identifier"},
        "action": {"$ref": "#/$defs/action"}
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "decisions"],
      "properties": {
        "seed": {"type": "string", "minLength": 1, "maxLength": 256},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "policy_id", "policy_version", "schedules"],
      "properties": {
        "schema_version": {"const": "datalox_delivery_intervention_policy_v2"},
        "policy_id": {"$ref": "#/$defs/identifier"},
        "policy_version": {"$ref": "#/$defs/identifier"},
        "schedules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/schedule"}}
      }
    }
  }
}
