{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalox.dev/schemas/composition-operation-claims-v1.schema.json",
  "title": "Datalox Composition Operation Claims v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "pack_version",
    "composition_pack_sha256",
    "provider_profiles",
    "reset_probe",
    "behavior_probes"
  ],
  "properties": {
    "schema_version": {"const": "datalox_composition_operation_claims_v1"},
    "pack_id": {"$ref": "#/$defs/identifier"},
    "pack_version": {"$ref": "#/$defs/identifier"},
    "composition_pack_sha256": {"$ref": "#/$defs/sha256"},
    "provider_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/providerProfile"}
    },
    "reset_probe": {"$ref": "#/$defs/resetProbe"},
    "behavior_probes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/probe"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "jsonValue": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "integer"},
        {"type": "number"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    },
    "providerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "profile_id",
        "release_manifest_sha256",
        "provider_runtime_sha256",
        "provider_admission_sha256",
        "operation_contract_sha256"
      ],
      "properties": {
        "provider_id": {"$ref": "#/$defs/identifier"},
        "profile_id": {"$ref": "#/$defs/identifier"},
        "release_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "provider_runtime_sha256": {"$ref": "#/$defs/sha256"},
        "provider_admission_sha256": {"$ref": "#/$defs/sha256"},
        "operation_contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["assertion_id", "source", "pointer", "operator", "expected_value"],
          "properties": {
            "assertion_id": {"$ref": "#/$defs/identifier"},
            "source": {"enum": ["action_result", "exported_evidence"]},
            "pointer": {"type": "string", "pattern": "^(?:$|/.*)$"},
            "operator": {"const": "equals"},
            "expected_value": {"$ref": "#/$defs/jsonValue"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["assertion_id", "source", "pointer", "operator", "expected_type"],
          "properties": {
            "assertion_id": {"$ref": "#/$defs/identifier"},
            "source": {"enum": ["action_result", "exported_evidence"]},
            "pointer": {"type": "string", "pattern": "^(?:$|/.*)$"},
            "operator": {"const": "type"},
            "expected_type": {
              "enum": ["object", "array", "string", "number", "integer", "boolean", "null"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["assertion_id", "source", "pointer", "operator", "expected_exists"],
          "properties": {
            "assertion_id": {"$ref": "#/$defs/identifier"},
            "source": {"enum": ["action_result", "exported_evidence"]},
            "pointer": {"type": "string", "pattern": "^(?:$|/.*)$"},
            "operator": {"const": "exists"},
            "expected_exists": {"type": "boolean"}
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_kind", "subject_id", "behavior"],
      "properties": {
        "subject_kind": {"enum": ["source_contract", "delivery_edge", "compensation"]},
        "subject_id": {"$ref": "#/$defs/identifier"},
        "behavior": {"$ref": "#/$defs/identifier"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "authority", "method", "path", "query", "headers", "body"],
      "properties": {
        "scheme": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^/"},
        "query": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": {
            "oneOf": [
              {"type": "string"},
              {"type": "array", "items": {"type": "string"}}
            ]
          }
        },
        "headers": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "not": {
              "pattern": "^(?:(?:[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Pp][Rr][Oo][Xx][Yy]-[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Cc][Oo][Oo][Kk][Ii][Ee]|[Ss][Ee][Tt]-[Cc][Oo][Oo][Kk][Ii][Ee]|[Xx]-[Aa][Pp][Ii]-[Kk][Ee][Yy]|[Aa][Pp][Ii]-[Kk][Ee][Yy])$|[Xx]-[Dd][Aa][Tt][Aa][Ll][Oo][Xx]-)"
            }
          },
          "additionalProperties": {"type": "string"}
        },
        "body": {"$ref": "#/$defs/jsonValue"}
      }
    },
    "httpResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status_code", "decision_kind", "headers", "body"],
      "properties": {
        "status_code": {"type": "integer", "minimum": 100, "maximum": 599},
        "decision_kind": {
          "enum": ["replay", "shadow_read", "shadow_write", "deny", "miss"]
        },
        "headers": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": {"type": "string"}
        },
        "body": {"$ref": "#/$defs/jsonValue"}
      }
    },
    "resetProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_result", "assertions"],
      "properties": {
        "expected_result": {"$ref": "#/$defs/jsonObject"},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step_id", "action", "provider_id", "operation_id", "principal_context_id", "request",
            "expected_result", "assertions", "covers"
          ],
          "properties": {
            "step_id": {"$ref": "#/$defs/identifier"},
            "action": {"const": "agent_http"},
            "provider_id": {"$ref": "#/$defs/identifier"},
            "operation_id": {"$ref": "#/$defs/identifier"},
            "principal_context_id": {"$ref": "#/$defs/identifier"},
            "request": {"$ref": "#/$defs/request"},
            "expected_result": {"$ref": "#/$defs/httpResult"},
            "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}},
            "covers": {"type": "array", "items": {"$ref": "#/$defs/coverage"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step_id", "action", "seconds", "expected_result", "assertions", "covers"],
          "properties": {
            "step_id": {"$ref": "#/$defs/identifier"},
            "action": {"const": "controller_advance"},
            "seconds": {"type": "integer", "minimum": 1, "maximum": 2592000},
            "expected_result": {"$ref": "#/$defs/jsonObject"},
            "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}},
            "covers": {"type": "array", "items": {"$ref": "#/$defs/coverage"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step_id", "action", "expected_result", "assertions", "covers"],
          "properties": {
            "step_id": {"$ref": "#/$defs/identifier"},
            "action": {"const": "controller_drain"},
            "expected_result": {"$ref": "#/$defs/jsonObject"},
            "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}},
            "covers": {"type": "array", "items": {"$ref": "#/$defs/coverage"}}
          }
        }
      ]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_id", "steps"],
      "properties": {
        "probe_id": {"$ref": "#/$defs/identifier"},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}
      }
    }
  }
}
