{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalox.dev/schemas/composition-session-export-v1.schema.json",
  "title": "Datalox admitted composition session evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack",
    "provider_profiles",
    "composition_delivery_time",
    "providers",
    "events",
    "status",
    "failure",
    "finalized",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "datalox_composition_session_export_v1"},
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_id",
        "pack_version",
        "composition_pack_sha256",
        "composition_admission_sha256",
        "distribution_label",
        "time_scope"
      ],
      "properties": {
        "pack_id": {"$ref": "#/$defs/identifier"},
        "pack_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "composition_pack_sha256": {"$ref": "#/$defs/sha256"},
        "composition_admission_sha256": {"$ref": "#/$defs/sha256"},
        "distribution_label": {"enum": ["public", "restricted", "private"]},
        "time_scope": {"const": "delivery_scheduler_only_v1"}
      }
    },
    "provider_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provider_profile"}
    },
    "composition_delivery_time": {"$ref": "#/$defs/timestamp"},
    "providers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/provider_export"}
    },
    "events": {"$ref": "#/$defs/event_export"},
    "status": {"enum": ["valid", "invalid"]},
    "failure": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["code"],
          "properties": {"code": {"$ref": "#/$defs/identifier"}}
        }
      ]
    },
    "finalized": {"type": "boolean"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "valid"}}},
      "then": {"properties": {"failure": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "invalid"}}},
      "then": {"properties": {"failure": {"type": "object"}}}
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "provider_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "profile_id",
        "release_manifest_sha256",
        "provider_runtime_sha256",
        "provider_admission_sha256",
        "operation_contract_sha256",
        "release_config_sha256"
      ],
      "properties": {
        "provider_id": {"$ref": "#/$defs/identifier"},
        "profile_id": {"$ref": "#/$defs/identifier"},
        "release_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "provider_runtime_sha256": {"$ref": "#/$defs/sha256"},
        "provider_admission_sha256": {"$ref": "#/$defs/sha256"},
        "operation_contract_sha256": {"$ref": "#/$defs/sha256"},
        "release_config_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provider_export": {
      "type": "object",
      "required": [
        "schema_version",
        "provider_id",
        "bundle_version",
        "authorities",
        "provider_state",
        "call_evidence"
      ],
      "properties": {
        "schema_version": {"const": "datalox_provider_run_v1"},
        "provider_id": {"$ref": "#/$defs/identifier"},
        "bundle_version": {"type": "string", "minLength": 1},
        "authorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "provider_state": {"type": "object"},
        "call_evidence": {"type": "object"}
      }
    },
    "event_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "episode_seed",
        "initial_time",
        "logical_time",
        "source_events",
        "deliveries",
        "post_outcome_effects",
        "state_digest"
      ],
      "properties": {
        "schema_version": {"const": "datalox_session_event_export_v1"},
        "episode_seed": {"$ref": "#/$defs/identifier"},
        "initial_time": {"$ref": "#/$defs/timestamp"},
        "logical_time": {"$ref": "#/$defs/timestamp"},
        "source_events": {"type": "array", "maxItems": 4096},
        "deliveries": {"type": "array", "maxItems": 8192},
        "post_outcome_effects": {"type": "array", "maxItems": 16384},
        "state_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
