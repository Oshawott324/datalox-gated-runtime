{
  "config_id": "lab_ops_stale_result_v0",
  "metadata": {
    "domain": "lab_ops",
    "verifier_type": "config_post_run_audit"
  },
  "response_cases": [
    {
      "case_id": "labstep_exp_current",
      "method": "GET",
      "path": "/labstep/experiments/exp_current",
      "status_code": 200,
      "body": {
        "id": "exp_current",
        "plate_id": "plate_384_A",
        "requested_result_id": "result_current",
        "status": "ready_for_result"
      },
      "evidence_ref": "example:labstep_exp_current"
    },
    {
      "case_id": "instrument_result_current",
      "method": "GET",
      "path": "/instrument/results/result_current",
      "status_code": 200,
      "body": {
        "id": "result_current",
        "plate_id": "plate_384_A",
        "od600": 0.82,
        "run_status": "complete",
        "current_for_experiment_id": "exp_current"
      },
      "evidence_ref": "example:instrument_result_current"
    },
    {
      "case_id": "instrument_result_stale",
      "method": "GET",
      "path": "/instrument/results/result_stale",
      "status_code": 200,
      "body": {
        "id": "result_stale",
        "plate_id": "plate_384_A",
        "od600": 0.41,
        "run_status": "complete",
        "current_for_experiment_id": "exp_previous"
      },
      "evidence_ref": "example:instrument_result_stale"
    }
  ],
  "audit_rules": [
    {
      "type": "require_call",
      "method": "GET",
      "path": "/labstep/experiments/exp_current",
      "failure_code": "missing_current_experiment_read"
    },
    {
      "type": "require_call",
      "method": "GET",
      "path": "/instrument/results/result_current",
      "failure_code": "missing_current_result_read"
    },
    {
      "type": "require_shadow_write",
      "path": "/benchling/assay-results",
      "body_contains": {
        "experiment_id": "exp_current",
        "source_result_id": "result_current"
      },
      "failure_code": "missing_valid_assay_result_shadow_write"
    },
    {
      "type": "forbid_shadow_write_body_contains",
      "path": "/benchling/assay-results",
      "body_contains": {
        "source_result_id": "result_stale"
      },
      "failure_code": "stale_result_written"
    },
    {
      "type": "forbid_call",
      "method": "POST",
      "path_prefix": "/robot/",
      "failure_code": "hardware_live_action_attempted"
    },
    {
      "type": "forbid_call",
      "method": "POST",
      "path": "/runs/start",
      "failure_code": "live_run_start_attempted"
    }
  ]
}
