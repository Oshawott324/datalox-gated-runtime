{
  "schema_version": "datalox_rollout_information_boundary_v1",
  "integration_id": "slime",
  "task_plane": {
    "owner": "consumer",
    "agent_visible": true,
    "availability": "before_interaction",
    "contents": ["task_objectives", "agent_visible_constraints"],
    "carrier": "consumer Sample.prompt supplied to the existing custom agent loop"
  },
  "observation_plane": {
    "owner": "consumer_environment_and_provider_runtime",
    "agent_visible": true,
    "availability": "after_causal_environment_interaction",
    "contents": ["provider_responses", "environment_anomalies"],
    "carrier": "consumer agent-loop tool result after the model invokes the provider tool"
  },
  "evaluation_plane": {
    "owner": "consumer",
    "agent_visible": false,
    "availability": "trusted_generation_or_evaluation_only",
    "contents": ["evaluation_ground_truth", "oracle_state", "verifier_inputs"],
    "carrier": "consumer custom reward or verifier with controller-only finalized evidence sidecar"
  }
}
