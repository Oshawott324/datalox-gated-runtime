{
  "name": "@datalox/mastra-commerce-support-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "smoke:positive": "tsx src/positive-control.ts",
    "smoke:negative": "tsx src/negative-control.ts",
    "verify": "npm run check && npm run smoke:positive && npm run smoke:negative",
    "experiment": "tsx src/live-experiment.ts",
    "studio": "tsx src/studio.ts"
  },
  "dependencies": {
    "@mastra/core": "1.61.0",
    "@mastra/libsql": "1.21.1",
    "@mastra/mcp": "1.17.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "mastra": "1.26.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
