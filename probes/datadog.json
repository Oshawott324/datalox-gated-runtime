      {"method": "GET", "path": "/api/v2/roles/{role_id}/users", "query": {"page[size]": "25"}},
      {"method": "GET", "path": "/api/v2/team/{team_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/team/{team_id}/links", "query": {}},
      {"method": "GET", "path": "/api/v2/team/{team_id}/memberships", "query": {"page[size]": "25"}},
      {"method": "GET", "path": "/api/v2/team/{team_id}/notification-rules", "query": {"page[size]": "25"}},
      {"method": "GET", "path": "/api/v2/team/{team_id}/permission-settings", "query": {}},
      {"method": "GET", "path": "/api/v2/team-hierarchy-links/{team_hierarchy_link_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/on-call/escalation-policies/{on_call_escalation_policy_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/on-call/schedules/{on_call_schedule_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/on-call/schedules/{on_call_schedule_id}/on-call", "query": {"include": "users"}},
      {"method": "GET", "path": "/api/v2/on-call/teams/{team_id}/on-call", "query": {"include": "users"}},
      {"method": "GET", "path": "/api/v2/on-call/teams/{team_id}/routing-rules", "query": {}},
      {"method": "GET", "path": "/api/v2/on-call/users/{on_call_user_id}/notification-channels", "query": {}},
      {"method": "GET", "path": "/api/v2/on-call/users/{on_call_user_id}/notification-channels/{on_call_channel_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/on-call/users/{on_call_user_id}/notification-rules", "query": {}},
      {"method": "GET", "path": "/api/v2/on-call/users/{on_call_user_id}/notification-rules/{on_call_rule_id}", "query": {}}
    ]
  },
  "probe_requests": [
    {"method": "GET", "path": "/api/v1/validate", "query": {}},
    {"method": "GET", "path": "/api/v1/monitor", "query": {"page": "0", "page_size": "25", "with_downtimes": "true"}},
    {"method": "GET", "path": "/api/v1/monitor/search", "query": {"page": "0", "per_page": "25"}},
    {"method": "GET", "path": "/api/v1/monitor/groups/search", "query": {"page": "0", "per_page": "25"}},
    {"method": "GET", "path": "/api/v2/monitor/policy", "query": {}},
    {"method": "GET", "path": "/api/v2/monitor/template", "query": {}},
    {"method": "GET", "path": "/api/v2/events", "query": {"filter[from]": "{from_ms}", "filter[to]": "{to_ms}", "page[limit]": "25", "sort": "-timestamp"}},
    {"method": "GET", "path": "/api/v2/incidents", "query": {"include": "commander_user", "page[size]": "25"}},
    {"method": "GET", "path": "/api/v2/incidents/search", "query": {"include": "commander_user", "page[size]": "25"}},
    {"method": "GET", "path": "/api/v2/incidents/config/global/incident-handles", "query": {}},
    {"method": "GET", "path": "/api/v2/incidents/config/global/settings", "query": {}},
    {"method": "GET", "path": "/api/v2/incidents/config/types", "query": {"include_deleted": "false"}},
    {"method": "GET", "path": "/api/v2/incidents/config/user-defined-fields", "query": {"include-deleted": "false", "page[size]": "25"}},
    {"method": "GET", "path": "/api/v2/incidents/config/notification-rules", "query": {"page[size]": "25"}},
    {"method": "GET", "path": "/api/v2/incidents/config/notification-templates", "query": {"page[size]": "25"}},
    {"method": "GET", "path": "/api/v2/incidents/config/postmortem-templates", "query": {}},
    {"method": "GET", "path": "/api/v2/services", "query": {"page[size]": "25"}},
    {"method": "GET", "path": "/api/v2/teams", "query": {"page[size]": "25"}},
    {"method": "GET", "path": "/api/v2/downtime", "query": {"include": "created_by", "page[limit]": "25"}},
    {"method": "GET", "path": "/api/v1/dashboard", "query": {"count": "25", "start": "0"}},
    {"method": "GET", "path": "/api/v1/dashboard/lists/manual", "query": {}},
    {"method": "GET", "path": "/api/v2/dashboards/usage", "query": {"page[limit]": "25", "page[offset]": "0"}},
    {"method": "GET", "path": "/api/v1/notebooks", "query": {"count": "25", "include_cells": "false", "start": "0"}},
    {"method": "GET", "path": "/api/v2/logs/events", "query": {"filter[from]": "{from_iso}", "filter[to]": "{to_iso}", "page[limit]": "25", "sort": "-timestamp"}},
    {"method": "GET", "path": "/api/v1/logs/config/indexes", "query": {}},
    {"method": "GET", "path": "/api/v1/logs/config/index-order", "query": {}},
    {"method": "GET", "path": "/api/v1/logs/config/pipelines", "query": {}},
    {"method": "GET", "path": "/api/v1/logs/config/pipeline-order", "query": {}},
    {"method": "GET", "path": "/api/v2/logs/config/metrics", "query": {}},
    {"method": "GET", "path": "/api/v2/metrics", "query": {"page[size]": "25", "window[seconds]": "1209600"}},
    {"method": "GET", "path": "/api/v1/metrics", "query": {"from": "{from_epoch}"}},
    {"method": "GET", "path": "/api/v1/query", "query": {"from": "{from_epoch}", "query": "{metric_query}", "to": "{to_epoch}"}},
    {"method": "GET", "path": "/api/v2/services/definitions", "query": {"page[size]": "25"}},
    {"method": "GET", "path": "/api/v2/catalog/entity", "query": {"includeDiscovered": "false", "page[limit]": "25"}},
    {"method": "GET", "path": "/api/v2/catalog/kind", "query": {"page[limit]": "25"}},
    {"method": "GET", "path": "/api/v2/catalog/relation", "query": {"includeDiscovered": "false", "page[limit]": "25"}},
    {"method": "GET", "path": "/api/v2/current_user", "query": {}},
    {"method": "GET", "path": "/api/v2/users", "query": {"page[size]": "25"}},
    {"method": "GET", "path": "/api/v2/permissions", "query": {}},
    {"method": "GET", "path": "/api/v2/roles", "query": {"page[size]": "25"}},
    {"method": "GET", "path": "/api/v2/team", "query": {"include": "memberships", "page[size]": "25"}},
    {"method": "GET", "path": "/api/v2/team-hierarchy-links", "query": {"page[size]": "25"}}
  ],
  "probe_status": "allowed",
  "provider_id": "datadog",
  "rate_budget": {
    "max_requests": 42,
    "min_interval_seconds": 0.25
  },
  "safe_read_prefixes": [
    "/api/v1/validate",
    "/api/v1/monitor",
    "/api/v2/monitor",
    "/api/v1/events",
    "/api/v2/events",
    "/api/v2/incidents",
    "/api/v2/services",
    "/api/v2/teams",
    "/api/v1/downtime",
    "/api/v2/downtime",
    "/api/v1/dashboard",
    "/api/v2/dashboard",
    "/api/v2/dashboards",
    "/api/v1/notebooks",
    "/api/v1/logs",
    "/api/v2/logs",
    "/api/v1/metrics",
    "/api/v1/query",
    "/api/v2/metrics",
    "/api/v2/catalog",
    "/api/v2/current_user",
    "/api/v1/user",
    "/api/v2/users",
    "/api/v2/permissions",
    "/api/v2/roles",
    "/api/v2/team",
    "/api/v2/team-hierarchy-links",
    "/api/v2/on-call"
  ],
  "static_headers": {
    "Accept": "application/json"
  },
  "tos_note": "Authenticated reads can expose sensitive observability, incident, log, user, and access-control data. Use a dedicated Datadog trial organization, least-privilege application-key scopes, explicit operator approval, and Datalox GET-only live capture."
}
