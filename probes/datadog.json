{
  "access_class": "approval_gated",
  "auth_profile": "datadog_keys",
  "auth_profiles": {
    "datadog_keys": {
      "inject": [
        {
          "env": "DD_API_KEY",
          "in": "header",
          "name": "DD-API-KEY",
          "scheme": ""
        },
        {
          "env": "DD_APPLICATION_KEY",
          "in": "header",
          "name": "DD-APPLICATION-KEY",
          "scheme": ""
        }
      ],
      "kind": "env_static"
    }
  },
  "base_url": "https://api.{dd_site}",
  "fixture_expansions": {
    "probe_requests": [
      {"method": "GET", "path": "/api/v1/monitor/{monitor_id}", "query": {"with_downtimes": "true"}},
      {"method": "GET", "path": "/api/v1/monitor/{monitor_id}/downtimes", "query": {}},
      {"method": "GET", "path": "/api/v2/monitor/{monitor_id}/downtime_matches", "query": {"page[limit]": "25"}},
      {"method": "GET", "path": "/api/v2/monitor/policy/{monitor_policy_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/monitor/template/{monitor_template_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/events/{event_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/incidents/{incident_id}", "query": {"include": "commander_user,created_by_user,last_modified_by_user"}},
      {"method": "GET", "path": "/api/v2/incidents/{incident_id}/attachments", "query": {"include": "last_modified_by_user"}},
      {"method": "GET", "path": "/api/v2/incidents/{incident_id}/impacts", "query": {}},
      {"method": "GET", "path": "/api/v2/incidents/{incident_id}/relationships/integrations", "query": {}},
      {"method": "GET", "path": "/api/v2/incidents/{incident_id}/relationships/todos", "query": {}},
      {"method": "GET", "path": "/api/v2/incidents/{incident_id}/relationships/todos/{incident_todo_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/services/{incident_service_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/teams/{incident_team_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/incidents/config/types/{incident_type_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/incidents/config/user-defined-fields/{incident_field_id}", "query": {"include": "created_by_user,last_modified_by_user"}},
      {"method": "GET", "path": "/api/v2/incidents/config/notification-rules/{incident_notification_rule_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/incidents/config/notification-templates/{incident_notification_template_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/incidents/config/postmortem-templates/{incident_postmortem_template_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/downtime/{downtime_id}", "query": {"include": "created_by"}},
      {"method": "GET", "path": "/api/v1/dashboard/{dashboard_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/dashboards/{dashboard_id}/usage", "query": {}},
      {"method": "GET", "path": "/api/v1/dashboard/lists/manual/{dashboard_list_id}", "query": {}},
      {"method": "GET", "path": "/api/v1/notebooks/{notebook_id}", "query": {}},
      {"method": "GET", "path": "/api/v1/logs/config/indexes/{log_index_name}", "query": {}},
      {"method": "GET", "path": "/api/v1/logs/config/pipelines/{log_pipeline_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/logs/config/metrics/{log_metric_id}", "query": {}},
      {"method": "GET", "path": "/api/v1/metrics/{metric_name}", "query": {}},
      {"method": "GET", "path": "/api/v2/metrics/{metric_name}/active-configurations", "query": {}},
      {"method": "GET", "path": "/api/v2/metrics/{metric_name}/all-tags", "query": {}},
      {"method": "GET", "path": "/api/v2/metrics/{metric_name}/assets", "query": {}},
      {"method": "GET", "path": "/api/v2/metrics/{metric_name}/tag-cardinalities", "query": {}},
      {"method": "GET", "path": "/api/v2/metrics/{metric_name}/tags", "query": {}},
      {"method": "GET", "path": "/api/v2/metrics/{metric_name}/volumes", "query": {}},
      {"method": "GET", "path": "/api/v2/services/definitions/{service_name}", "query": {"schema_version": "v2.2"}},
      {"method": "GET", "path": "/api/v2/users/{user_id}", "query": {}},
      {"method": "GET", "path": "/api/v2/users/{user_id}/orgs", "query": {}},
      {"method": "GET", "path": "/api/v2/users/{user_id}/permissions", "query": {}},
      {"method": "GET", "path": "/api/v2/users/{user_id}/memberships", "query": {}},
      {"method": "GET", "path": "/api/v2/roles/{role_id}", "query": {}},
