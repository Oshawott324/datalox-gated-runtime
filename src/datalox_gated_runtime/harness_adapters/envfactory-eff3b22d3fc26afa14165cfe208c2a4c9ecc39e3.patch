         return parsed_schema

+    @staticmethod
+    def _root_parameters(schema: dict, *, root_schema: dict) -> list[Parameter]:
+        if "$ref" in schema:
+            reference = schema["$ref"]
+            if not isinstance(reference, str) or not reference.startswith("#/"):
+                raise ValueError(f"Unsupported JSON Schema reference: {reference!r}")
+            resolved = root_schema
+            for token in reference[2:].split("/"):
+                token = token.replace("~1", "/").replace("~0", "~")
+                if not isinstance(resolved, dict) or token not in resolved:
+                    raise ValueError(f"Unresolved JSON Schema reference: {reference}")
+                resolved = resolved[token]
+            if not isinstance(resolved, dict):
+                raise ValueError(f"JSON Schema reference is not an object: {reference}")
+            return Tool._root_parameters(resolved, root_schema=root_schema)
+
+        variants = schema.get("anyOf") or schema.get("oneOf") or schema.get("allOf")
+        if isinstance(variants, list):
+            parameters = []
+            seen = set()
+            for variant in variants:
+                if not isinstance(variant, dict):
+                    continue
+                for parameter in Tool._root_parameters(variant, root_schema=root_schema):
+                    key = (parameter.name, parameter.data_type)
+                    if key in seen:
+                        continue
+                    seen.add(key)
+                    parameters.append(parameter)
+            return parameters
+
+        root_type = schema.get("type", "unknown")
+        if isinstance(root_type, list):
+            return Tool._root_parameters(
+                {
+                    "anyOf": [
+                        {"type": item, "description": schema.get("description", "")}
+                        for item in root_type
+                    ]
+                },
+                root_schema=root_schema,
+            )
+        description = schema.get("description", "")
+        if root_type == "null":
+            return []
+        if root_type == "object":
+            properties = schema.get("properties")
+            if isinstance(properties, dict) and properties:
+                return [
+                    Parameter(
+                        name=name,
+                        description=info.get("description", ""),
+                        data_type=info.get("type", "unknown"),
+                    )
+                    for name, info in properties.items()
+                ]
+            additional = schema.get("additionalProperties")
+            if isinstance(additional, dict):
+                return [
+                    Parameter(
+                        name="$value",
+                        description=additional.get("description", description),
+                        data_type=additional.get("type", "unknown"),
+                    )
+                ]
+            return []
+        if root_type != "array":
+            return [Parameter(name="$result", description=description, data_type=root_type)]
+
+        items = schema.get("items")
+        if not isinstance(items, dict):
+            return [Parameter(name="$item", description=description, data_type="unknown")]
+        if "$ref" in items:
+            parameters = Tool._root_parameters(items, root_schema=root_schema)
+            for parameter in parameters:
+                if parameter.name == "$result":
+                    parameter.name = "$item"
+            return parameters
+        item_variants = items.get("anyOf") or items.get("oneOf")
+        if isinstance(item_variants, list):
+            parameters = Tool._root_parameters(
+                {"anyOf": item_variants},
+                root_schema=root_schema,
+            )
+            for parameter in parameters:
+                if parameter.name == "$result":
+                    parameter.name = "$item"
+            return parameters
+        properties = items.get("properties")
+        if items.get("type") == "object" and isinstance(properties, dict) and properties:
+            return [
+                Parameter(
+                    name=name,
+                    description=info.get("description", ""),
+                    data_type=info.get("type", "unknown"),
+                )
+                for name, info in properties.items()
+            ]
+        return [
+            Parameter(
+                name="$item",
+                description=items.get("description", description),
+                data_type=items.get("type", "unknown"),
+            )
+        ]
+
     def __repr__(self):
         return f"Tool({self.name})"

